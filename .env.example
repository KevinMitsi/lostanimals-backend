# Copy to .env and inject it with Docker --env-file or Compose env_file; Spring does not load it automatically.
# Database used by R2DBC at runtime and JDBC/Flyway during startup.
R2DBC_URL=r2dbc:postgresql://CHANGE_ME_RDS_HOST:5432/animales_perdidos
JDBC_URL=jdbc:postgresql://CHANGE_ME_RDS_HOST:5432/animales_perdidos
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Reactive connection pool. Keep max-size aligned with RDS max connections and replica count.
SPRING_R2DBC_POOL_ENABLED=true
SPRING_R2DBC_POOL_INITIAL_SIZE=2
SPRING_R2DBC_POOL_MAX_SIZE=10
SPRING_R2DBC_POOL_MAX_IDLE_TIME=PT30M

# Authentication. Generate at least 64 random bytes for production.
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_BYTES
JWT_ISSUER=animales-perdidos-colombia
# Independent Base64-encoded 32-byte keys. Keep them in the production secret store and preserve them for recovery.
PERSONAL_DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
PERSONAL_DATA_LOOKUP_KEY=CHANGE_ME_DIFFERENT_BASE64_32_BYTES

# JVM/container lifecycle.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# AWS SDK region and S3 bucket name (not the bucket ARN).
AWS_REGION=us-east-1
S3_BUCKET=CHANGE_ME_BUCKET_NAME

# Prefer an EC2 Instance Role. Only set static keys outside AWS or during controlled local tests.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS -> SES/SNS asynchronous notifications.
AWS_NOTIFICATIONS_ENABLED=true
AWS_NOTIFICATION_QUEUE_URL=CHANGE_ME_SQS_QUEUE_URL
AWS_SES_SENDER_EMAIL=no-reply@animales-perdidos.com
AWS_SNS_PLATFORM_APPLICATION_ARN=CHANGE_ME_SNS_PLATFORM_APPLICATION_ARN
AWS_NOTIFICATION_MAX_MESSAGES=10
AWS_NOTIFICATION_WAIT_SECONDS=20
AWS_NOTIFICATION_VISIBILITY_SECONDS=60
AWS_NOTIFICATION_POLL_DELAY_MS=1000
FRONTEND_BASE_URL=https://www.animales-perdidos.com

# Turnstile. expected-hostname is only the hostname, without scheme, port or path.
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SECRET=CHANGE_ME
CLOUDFLARE_EXPECTED_HOSTNAME=www.animales-perdidos.com
# Enable only after the origin accepts traffic exclusively through Cloudflare/Tunnel.
CLOUDFLARE_TRUST_CONNECTING_IP=false

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://www.animales-perdidos.com
# Google Identity Services web client ID. The client secret is not used by this ID-token flow.
GOOGLE_CLIENT_ID=107998184654-a50tcvv3nbgkdkmj34gg09kjhor4q1gs.apps.googleusercontent.com
